{
  "hosting": {
    "site": "yass-noir",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|mp4|webm)",
        "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]
      }
    ],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  }
}
